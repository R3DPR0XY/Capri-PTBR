{
  "name": "capri-companion",
  "version": "0.2.0-ptbr.1",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:e2e": "node scripts/build.mjs && vitest run tests/e2e --no-file-parallelism --testTimeout=60000 --hookTimeout=60000",
    "icons": "node scripts/build.mjs && node scripts/make-icons.mjs",
    "dist": "node scripts/dist.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "author": "R3DPR0XY (versão PT-BR) · original: Capri Companion contributors",
  "license": "MIT",
  "description": "Capri PT-BR \u2014 companheira de IA para o desktop, versão em português por R3DPR0XY (projeto de fã, não oficial)",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "koffi": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "productName": "Capri",
  "private": true,
  "build": {
    "appId": "dev.r3dpr0xy.capri.ptbr",
    "productName": "Capri",
    "copyright": "Versão PT-BR por R3DPR0XY, baseada no Capri Companion (MIT). Projeto de fã não oficial, sem vínculo com CD PROJEKT, Studio Trigger ou Netflix.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Projeto de fã não oficial"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Capri",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Capri-Setup-${version}.exe"
    }
  }
}
